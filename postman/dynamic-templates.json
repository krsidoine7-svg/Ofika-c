            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseFields\": {\n    \"name\": \"Jean Dupont\",\n    \"bio\": \"Entrepreneur passionné par la tech\",\n    \"email\": \"jean@exemple.com\",\n    \"phone\": \"+33 6 12 34 56 78\",\n    \"custom_url\": \"jean-dupont\",\n    \"image_url\": \"https://exemple.com/photo.jpg\",\n    \"is_public\": true,\n    \"whatsapp\": \"+33 6 12 34 56 78\",\n    \"instagram\": \"@jeandupont\",\n    \"twitter\": \"@jeandupont\"\n  },\n  \"templateId\": \"{{design1_template_id}}\",\n  \"templateFields\": {\n    \"company\": \"Tech Corp\",\n    \"position\": \"CEO\",\n    \"linkedin\": \"https://linkedin.com/in/jeandupont\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profiles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profiles"]
