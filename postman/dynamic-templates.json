{
  "info": {
    "name": "Ofika - Dynamic Templates API",
    "description": "Collection Postman pour tester les APIs de templates dynamiques",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Templates",
      "item": [
        {
          "name": "GET All Templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "templates"]
            },
            "description": "Récupère tous les templates actifs"
          },
          "response": []
        },
        {
          "name": "HEAD Templates (Health Check)",
          "request": {
            "method": "HEAD",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/templates",
              "host": ["{{baseUrl}}"],
              "path": ["api", "templates"]
            },
            "description": "Vérifie la disponibilité de l'API"
          },
          "response": []
        }
      ]
    },
    {
